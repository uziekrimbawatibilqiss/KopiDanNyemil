<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat Pengiriman"
            android:textColor="#5B3825"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu yang Dipilih"
            android:textColor="#795548"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2D2AE"
            android:padding="14dp"
            android:text="Nama Menu"
            android:textColor="#5B3825"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Harga"
            android:textColor="#795548"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2D2AE"
            android:padding="14dp"
            android:text="Rp0"
            android:textColor="#5B3825"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nama Penerima"
            android:textColor="#5B3825"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nama penerima"
            android:inputType="textPersonName"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nomor HP"
            android:textColor="#5B3825"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAddressPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nomor HP"
            android:inputType="phone"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Alamat Lengkap"
            android:textColor="#5B3825"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top"
            android:hint="Nama jalan, nomor rumah, RT/RW, kelurahan, dan kecamatan"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Catatan (Opsional)"
            android:textColor="#5B3825"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Rumah pagar hitam"
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Lanjutkan"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5B3825" />

    </LinearLayout>
</ScrollView>
